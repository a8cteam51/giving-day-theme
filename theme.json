{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1280px"
		},
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{ "slug": "primary",    "color": "#111827", "name": "Primary" },
				{ "slug": "secondary",  "color": "#374151", "name": "Secondary" },
				{ "slug": "tertiary",   "color": "#6B7280", "name": "Muted" },
				{ "slug": "accent",     "color": "#2563EB", "name": "Accent" },
				{ "slug": "background", "color": "#FFFFFF", "name": "Background" },
				{ "slug": "base",       "color": "#FFFFFF", "name": "Base" },
				{ "slug": "base-2",     "color": "#F3F4F6", "name": "Base alt" },
				{ "slug": "contrast",   "color": "#0F172A", "name": "Contrast" }
			],
			"gradients": [
				{
					"slug": "primary-secondary",
					"name": "Primary to Secondary",
					"gradient": "linear-gradient(135deg, var(--wp--preset--color--primary) 0%, var(--wp--preset--color--secondary) 100%)"
				},
				{
					"slug": "primary-accent",
					"name": "Primary to Accent",
					"gradient": "linear-gradient(135deg, var(--wp--preset--color--primary) 0%, var(--wp--preset--color--accent) 100%)"
				},
				{
					"slug": "soft-fade",
					"name": "Soft fade",
					"gradient": "linear-gradient(180deg, var(--wp--preset--color--base) 0%, var(--wp--preset--color--base-2) 100%)"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "inter",
					"name": "Inter",
					"fontFamily": "Inter, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontWeight": "100 900",
							"fontStyle": "normal",
							"fontStretch": "100%",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/inter/Inter-Variable.woff2" ]
						},
						{
							"fontFamily": "Inter",
							"fontWeight": "100 900",
							"fontStyle": "italic",
							"fontStretch": "100%",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/inter/Inter-Variable-Italic.woff2" ]
						}
					]
				},
				{
					"slug": "source-serif",
					"name": "Source Serif",
					"fontFamily": "\"Source Serif 4\", Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{
							"fontFamily": "Source Serif 4",
							"fontWeight": "200 900",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/source-serif/SourceSerif4-Variable.woff2" ]
						},
						{
							"fontFamily": "Source Serif 4",
							"fontWeight": "200 900",
							"fontStyle": "italic",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/source-serif/SourceSerif4-Variable-Italic.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small",    "size": "0.875rem", "name": "Small",    "fluid": false },
				{ "slug": "medium",   "size": "1rem",     "name": "Medium",   "fluid": { "min": "1rem",     "max": "1.0625rem" } },
				{ "slug": "large",    "size": "1.25rem",  "name": "Large",    "fluid": { "min": "1.125rem", "max": "1.375rem" } },
				{ "slug": "x-large",  "size": "2rem",     "name": "X-Large",  "fluid": { "min": "1.5rem",   "max": "2.25rem" } },
				{ "slug": "xx-large", "size": "3rem",     "name": "XX-Large", "fluid": { "min": "2rem",     "max": "3.5rem" } },
				{ "slug": "display",  "size": "4.5rem",   "name": "Display",  "fluid": { "min": "2.75rem",  "max": "5rem" } }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "%", "px", "em", "rem", "vh", "vw" ],
			"spacingSizes": [
				{ "slug": "10", "size": "clamp(0.25rem, 0.5vw, 0.5rem)",   "name": "1 — 2X-Small" },
				{ "slug": "20", "size": "clamp(0.5rem, 1vw, 0.75rem)",     "name": "2 — X-Small" },
				{ "slug": "30", "size": "clamp(0.75rem, 1.5vw, 1rem)",     "name": "3 — Small" },
				{ "slug": "40", "size": "clamp(1rem, 2vw, 1.5rem)",        "name": "4 — Medium" },
				{ "slug": "50", "size": "clamp(1.5rem, 3vw, 2.5rem)",      "name": "5 — Large" },
				{ "slug": "60", "size": "clamp(2.5rem, 5vw, 4rem)",        "name": "6 — X-Large" },
				{ "slug": "70", "size": "clamp(4rem, 8vw, 6.5rem)",        "name": "7 — 2X-Large" }
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "sm",  "name": "Small",  "shadow": "0 1px 2px 0 rgba(15, 23, 42, 0.05)" },
				{ "slug": "md",  "name": "Medium", "shadow": "0 4px 12px -2px rgba(15, 23, 42, 0.08)" },
				{ "slug": "lg",  "name": "Large",  "shadow": "0 12px 32px -8px rgba(15, 23, 42, 0.12)" }
			]
		}
	},
	"styles": {
		"css": ".site-header .wp-block-buttons{flex-shrink:0}.site-header .wp-block-button__link,.is-style-donate-pill .wp-block-button__link{white-space:nowrap}.site-header .wp-block-site-title{white-space:nowrap}.site-header .is-style-donate-pill .wp-block-button__link{padding-top:var(--wp--preset--spacing--20);padding-bottom:var(--wp--preset--spacing--20);padding-left:var(--wp--preset--spacing--40);padding-right:var(--wp--preset--spacing--40);font-size:var(--wp--preset--font-size--medium);line-height:1.2}",
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--primary)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inter)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6",
			"fontWeight": "400"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--40)",
			"padding": {
				"top": "0",
				"right": "var(--wp--preset--spacing--40)",
				"bottom": "0",
				"left": "var(--wp--preset--spacing--40)"
			}
		},
		"elements": {
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--source-serif)",
					"fontSize": "var(--wp--preset--font-size--display)",
					"fontWeight": "600",
					"lineHeight": "1.05",
					"letterSpacing": "-0.02em"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--source-serif)",
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"fontWeight": "600",
					"lineHeight": "1.15",
					"letterSpacing": "-0.015em"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--inter)",
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "700",
					"lineHeight": "1.25"
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--inter)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "600",
					"lineHeight": "1.3"
				}
			},
			"h5": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--inter)",
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "600",
					"textTransform": "uppercase",
					"letterSpacing": "0.05em"
				}
			},
			"h6": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--inter)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600",
					"textTransform": "uppercase",
					"letterSpacing": "0.08em"
				},
				"color": {
					"text": "var(--wp--preset--color--tertiary)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--background)"
				},
				"border": {
					"radius": "9999px"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--inter)",
					"fontWeight": "600",
					"fontSize": "var(--wp--preset--font-size--medium)",
					"textDecoration": "none"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--30)",
						"right": "var(--wp--preset--spacing--50)",
						"bottom": "var(--wp--preset--spacing--30)",
						"left": "var(--wp--preset--spacing--50)"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary)",
						"text": "var(--wp--preset--color--background)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--primary)",
						"text": "var(--wp--preset--color--background)"
					}
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				},
				":hover": {
					"typography": {
						"textDecoration": "underline"
					}
				}
			},
			"caption": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"color": {
					"text": "var(--wp--preset--color--tertiary)"
				}
			}
		},
		"blocks": {
			"core/heading": {
				"variations": {
					"display-serif": {
						"typography": {
							"fontFamily": "var(--wp--preset--font-family--source-serif)",
							"fontSize": "var(--wp--preset--font-size--display)",
							"fontWeight": "700",
							"lineHeight": "1.02",
							"letterSpacing": "-0.025em"
						}
					},
					"eyebrow": {
						"typography": {
							"fontFamily": "var(--wp--preset--font-family--inter)",
							"fontSize": "var(--wp--preset--font-size--small)",
							"fontWeight": "600",
							"textTransform": "uppercase",
							"letterSpacing": "0.1em"
						},
						"color": {
							"text": "var(--wp--preset--color--accent)"
						}
					}
				}
			},
			"core/button": {
				"variations": {
					"donate-pill": {
						"typography": {
							"fontSize": "var(--wp--preset--font-size--large)",
							"fontWeight": "700"
						},
						"spacing": {
							"padding": {
								"top": "var(--wp--preset--spacing--40)",
								"right": "var(--wp--preset--spacing--60)",
								"bottom": "var(--wp--preset--spacing--40)",
								"left": "var(--wp--preset--spacing--60)"
							}
						},
						"border": { "radius": "9999px" },
						"color": {
							"background": "var(--wp--preset--color--accent)",
							"text": "var(--wp--preset--color--background)"
						}
					},
					"ghost": {
						"color": {
							"background": "transparent",
							"text": "var(--wp--preset--color--accent)"
						},
						"border": {
							"radius": "9999px",
							"width": "2px",
							"style": "solid",
							"color": "var(--wp--preset--color--accent)"
						}
					}
				}
			},
			"core/group": {
				"variations": {
					"card-elevated": {
						"color": {
							"background": "var(--wp--preset--color--base)"
						},
						"border": {
							"radius": "12px"
						},
						"shadow": "var(--wp--preset--shadow--md)",
						"spacing": {
							"padding": {
								"top": "var(--wp--preset--spacing--50)",
								"right": "var(--wp--preset--spacing--50)",
								"bottom": "var(--wp--preset--spacing--50)",
								"left": "var(--wp--preset--spacing--50)"
							}
						}
					},
					"card-outline": {
						"color": {
							"background": "var(--wp--preset--color--base)"
						},
						"border": {
							"radius": "12px",
							"width": "1px",
							"style": "solid",
							"color": "var(--wp--preset--color--base-2)"
						},
						"spacing": {
							"padding": {
								"top": "var(--wp--preset--spacing--50)",
								"right": "var(--wp--preset--spacing--50)",
								"bottom": "var(--wp--preset--spacing--50)",
								"left": "var(--wp--preset--spacing--50)"
							}
						}
					}
				}
			},
			"core/pullquote": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--source-serif)",
					"fontStyle": "italic"
				},
				"variations": {
					"impact": {
						"typography": {
							"fontFamily": "var(--wp--preset--font-family--source-serif)",
							"fontSize": "var(--wp--preset--font-size--xx-large)",
							"fontStyle": "normal",
							"fontWeight": "600",
							"lineHeight": "1.2"
						},
						"border": {
							"top": { "width": "4px", "style": "solid", "color": "var(--wp--preset--color--accent)" },
							"bottom": { "width": "0" }
						},
						"spacing": {
							"padding": {
								"top": "var(--wp--preset--spacing--50)",
								"bottom": "var(--wp--preset--spacing--50)"
							}
						}
					}
				}
			},
			"core/separator": {
				"variations": {
					"accent-rule": {
						"color": {
							"background": "var(--wp--preset--color--accent)"
						},
						"border": {
							"top": { "width": "4px", "style": "solid", "color": "var(--wp--preset--color--accent)" }
						}
					}
				}
			},
			"core/quote": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--source-serif)",
					"fontStyle": "italic"
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--source-serif)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "700"
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--inter)",
					"fontWeight": "500"
				}
			},
			"core/details": {
				"border": {
					"top": { "width": "1px", "style": "solid", "color": "var(--wp--preset--color--base-2)" },
					"bottom": { "width": "1px", "style": "solid", "color": "var(--wp--preset--color--base-2)" }
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--30)",
						"bottom": "var(--wp--preset--spacing--30)"
					}
				}
			}
		}
	},
	"customTemplates": [
		{ "name": "page-donate",      "title": "Donate Page",      "postTypes": [ "page" ] },
		{ "name": "page-leaderboard", "title": "Leaderboard",      "postTypes": [ "page" ] },
		{ "name": "page-thank-you",   "title": "Thank You",        "postTypes": [ "page" ] },
		{ "name": "page-donor-wall",  "title": "Donor Wall",       "postTypes": [ "page" ] },
		{ "name": "page-sponsors",    "title": "Sponsors",         "postTypes": [ "page" ] },
		{ "name": "page-faq",         "title": "FAQ",              "postTypes": [ "page" ] },
		{ "name": "page-contact",     "title": "Contact",          "postTypes": [ "page" ] },
		{ "name": "page-no-title",    "title": "No Title",         "postTypes": [ "page" ] }
	],
	"templateParts": [
		{ "name": "header",           "title": "Header",            "area": "header" },
		{ "name": "header-minimal",   "title": "Minimal Header",    "area": "header" },
		{ "name": "footer",           "title": "Footer",            "area": "footer" },
		{ "name": "footer-tagline",   "title": "Footer Tagline",    "area": "footer" },
		{ "name": "sidebar-campaign", "title": "Campaign Sidebar",  "area": "uncategorized" }
	]
}
