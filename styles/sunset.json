{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Sunset",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "primary",    "color": "#2A1A2A", "name": "Primary" },
				{ "slug": "secondary",  "color": "#C06C84", "name": "Secondary" },
				{ "slug": "tertiary",   "color": "#B89BAA", "name": "Muted" },
				{ "slug": "accent",     "color": "#F67280", "name": "Accent" },
				{ "slug": "background", "color": "#FFF1F4", "name": "Background" },
				{ "slug": "base",       "color": "#FFFFFF", "name": "Base" },
				{ "slug": "base-2",     "color": "#F8DEE3", "name": "Base alt" },
				{ "slug": "contrast",   "color": "#1A0F1F", "name": "Contrast" },
				{ "slug": "dusk",       "color": "#6C5B7B", "name": "Dusk" },
				{ "slug": "twilight",   "color": "#355C7D", "name": "Twilight" }
			]
		}
	},
	"styles": {
		"elements": {
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--source-serif)",
					"fontStyle": "italic",
					"fontWeight": "500",
					"letterSpacing": "-0.015em",
					"lineHeight": "1.05"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--source-serif)",
					"fontStyle": "italic",
					"fontWeight": "500"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary)",
						"text": "var(--wp--preset--color--background)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--primary)",
						"text": "var(--wp--preset--color--background)"
					}
				}
			}
		}
	}
}
